POSTGRES_DB=wenjin
POSTGRES_USER=wenjin
POSTGRES_PASSWORD=change-me
COMPOSE_PROJECT_NAME=wenjin-ai-admission
FRONTEND_PORT=3000
BACKEND_PORT=8080
PGVECTOR_IMAGE=pgvector/pgvector:pg17
REDIS_IMAGE=redis:7.4-alpine
MAVEN_IMAGE=maven:3.9.11-eclipse-temurin-21
JAVA_RUNTIME_IMAGE=eclipse-temurin:21-jre
NODE_IMAGE=node:24-alpine
REDIS_HOST=redis
REDIS_PORT=6379
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_SECURE_COOKIE=false

AI_MODE=mock
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=
AI_FAST_MODEL=
AI_EMBEDDING_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2048
# 可选：留空时后端会在 .local/ai-config.key 自动生成前端配置加密密钥
AI_CONFIG_ENCRYPTION_KEY=
AI_CONFIG_KEY_PATH=./.local/ai-config.key

NEXT_PUBLIC_API_BASE_URL=/api/backend
BACKEND_INTERNAL_URL=http://backend:8080
